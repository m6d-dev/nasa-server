# ===== DATABASE =====
POSTGRES_DB=vigil
POSTGRES_USER=vigil
POSTGRES_PASSWORD=vigil
# `postgres` inside docker-compose, `localhost` when the server runs on the host
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# host port the postgres container is published on
POSTGRES_EXTERNAL_PORT=5432

# ===== SERVER =====
HOST=0.0.0.0
PORT=8000
CORS_ORIGIN=*
# YYYY-MM-DD of flight day 1; empty -> first day with data
MISSION_START=

# ===== VIRTUAL DEVICE =====
VDEV_URL=http://localhost:8100

# ===== LLM (empty URL -> template texts only) =====
OLLAMA_URL=
OLLAMA_MODEL=vigil-narrator
LLM_TIMEOUT_S=5

# ===== ML / CONTENT FILES =====
PATTERN_MODEL=ml/models/pattern.json
PATTERN_META=ml/models/pattern_meta.json
ACTIONS_FILE=docs/actions.yaml

# ===== RADIATION (NASA OSDR RadLab) =====
RADLAB_DIR=data/radlab
# empty -> the instrument with most samples
RADLAB_INSTRUMENT=
# unit of absorbed_dose_rate in the files: uGy/h | uGy/min | mGy/day  [verify]
RADLAB_RATE_UNIT=uGy/h
